{
  "rules": {
    ".read": false,
    ".write": false,
    "envs": {
      "$env": {
        "config": {
          ".read": "$env === 'prod' || $env === 'test'"
        },
        "queue": {
          ".read": "$env === 'prod' || $env === 'test'"
        },
        "log": {
          ".read": "$env === 'prod' || $env === 'test'"
        },
        "dedupe": {
          ".indexOn": [
            ".value"
          ]
        },
        "state": {
          ".read": "$env === 'prod' || $env === 'test'"
        },
        "overlay": {
          "events": {
            ".read": "$env === 'prod' || $env === 'test'"
          }
        }
      }
    }
  }
}
